# ============================================================
# DigitalNest — Environment Variables
# Copy to `.env` and fill in real values before `npm run build`.
# ============================================================

# ---- Server runtime ----
# Port the Node server listens on (Nitro node-server preset).
# cPanel sets this automatically; on a VPS choose any free port.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Nitro build preset ----
# node-server (default for npm run build), cloudflare-module, vercel, netlify, bun, deno-server
NITRO_PRESET=node-server

# ============================================================
# Supabase (Lovable Cloud backend)
# ============================================================
# Public — exposed to the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side mirrors (used during SSR / server functions).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=your-project-ref

# PRIVATE — never expose. Required for admin/server actions
# (license assignment, webhooks, admin RPCs).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Email (Resend)
# ============================================================
# Leave EMAILS_ENABLED=false to queue without sending (dev mode).
EMAILS_ENABLED=false
RESEND_API_KEY=

# ============================================================
# Payment gateways (only set what you enable in /admin/gateways)
# ============================================================
# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Custom auto-gateway HMAC secret (for /api/public/payments.custom-webhook.*)
CUSTOM_GATEWAY_WEBHOOK_SECRET=

# Generic payment webhook HMAC (legacy /api/public/payments.webhook)
PAYMENT_WEBHOOK_SECRET=

# ============================================================
# Monitoring (optional)
# ============================================================
VITE_SENTRY_DSN=
SENTRY_DSN=
